{% from "components/list/_macro.njk" import onsList %}

{% set pageConfig = {
    "title": "Census Prototypes",
    "themeColor": "#902082",
    "header": {
        "title": "Census Prototypes",
        "mastheadLogoUrl": "/"
    },
    "footer": {
        "oglLink": true
    }
} %}

{% block head %}
    <link rel="stylesheet" href="/styles.css"/>
{% endblock %}

{% block main %}
    {% set groups = helpers.navigationHelper({
        "pages": prototypeListing,
        "ignorePaths": ["/", "/prototypes"]
    }) %}
    {% for group in groups %}
        {% if group.title != "Examples" %}
            <section>
                <h1 class="u-fs-m">{{ group.title }}</h1>
                {% if group.title == "Census Test 2027" %}
                    {{
                        onsList({
                            "classes": "ons-list--bare",
                            "itemsList": [
                                {
                                    "text": "Students in halls end-to-end (All materials with crown)",
                                    "url": "/prototypes/student-in-halls/poster-1.html?crown=1"
                                },
                                {
                                    "text": "Students in halls end-to-end (All materials no crown)",
                                    "url": "/prototypes/student-in-halls/poster-1.html?crown=0"
                                },
                                {
                                    "text": "Students in halls end-to-end (Postcard only with crown)",
                                    "url": "/prototypes/student-in-halls/poster-3.html?crown=1"
                                },
                                {
                                    "text": "Students in halls end-to-end (Postcard only no crown)",
                                    "url": "/prototypes/student-in-halls/poster-3.html?crown=0"
                                }
                            ]
                        })
                    }}
                {% else %}
                    {{
                        onsList({
                            "classes": "ons-list--bare",
                            "itemsList": group.items
                        })
                    }}
                {% endif %}
            </section>
        {% endif %}
    {% endfor %}
{% endblock %}
