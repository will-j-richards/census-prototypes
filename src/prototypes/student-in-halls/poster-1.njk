{% set pageConfig = {
    "title": "Census Prototypes",
    "bodyClasses": "splash-page"
} %}

{% block head %}
    <link rel="stylesheet" href="/styles.css"/>
{% endblock %}

{% block body %}
    <a
        class="splash-page__link"
        data-materials-link="{{ pageInfo.rootPath }}/poster-2.html"
        href="{{ pageInfo.rootPath }}/poster-2.html?crown=1"
    >
        <img
            class="splash-page__image"
            data-material="aware-poster"
            src="{{ pageInfo.rootPath }}/img/aware-poster-crown.png"
            alt="Aware poster"
        >
    </a>
    <script src="{{ pageInfo.rootPath }}/materials.js"></script>
{% endblock %}
