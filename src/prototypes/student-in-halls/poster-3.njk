{% set pageConfig = {
    "title": "Census Prototypes",
    "bodyClasses": "poster-page"
} %}

{% block head %}
    <link rel="stylesheet" href="/styles.css"/>
{% endblock %}

{% block body %}
    <div class="poster-page__grid">
        <a
            class="poster-page__link"
            href="{{ pageInfo.rootPath }}/index.html"
        >
            <img
                class="poster-page__image"
                src="{{ pageInfo.rootPath }}/img/followup-postcard-front.png"
                alt="Follow-up postcard front"
            >
        </a>
        <a
            class="poster-page__link"
            href="{{ pageInfo.rootPath }}/index.html"
        >
            <img
                class="poster-page__image"
                src="{{ pageInfo.rootPath }}/img/followup-postcard-back.png"
                alt="Follow-up postcard back"
            >
        </a>
    </div>
{% endblock %}
