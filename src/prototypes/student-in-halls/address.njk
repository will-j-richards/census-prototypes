---
group: Census Test 2027
title: Student in halls
layout: student-in-halls/views/_main
---
{% from "components/question/_macro.njk" import onsQuestion %}
{% from "components/custom-components/_macro.njk" import onsAddressInput %}
{% from "components/panel/_macro.njk" import onsPanel %}
{% from "components/list/_macro.njk" import onsList %}
{% from "components/details/_macro.njk" import onsDetails %}

{% set prevPage = "index" %}
{% set formActionURL = pageInfo.rootPath + "/confirm.html" %}

{% block bodyStart %}
    <form class="form-class" method="GET" autocomplete="off" novalidate action="{{ formActionURL }}">
{% endblock %}

{% block main %}
    {%
        call onsQuestion({
            "title": "What is your address?",
            "submitButton": {
                "text": "Continue"
            }
        })
    %}
        <p>Enter your address to request an access code. You will need a UK mobile to receive the code as a text message.</p>
        {% call onsPanel({
            "spacious": true,
            "classes": "ons-u-mb-m"
        }) %}
            {{
                onsList({
                    "itemsList": [
                        {
                            "text": "If you are studying in the UK, for 3 months or more, enter the UK address where you live while studying."
                        },
                        {
                            "text": "For everyone else, enter your UK address on 14 March 2027."
                        }
                    ]
                })
            }}
        {% endcall %}
        {# Hint temporarily removed from address label:
           "description": "For example: Room 15, Block C, University Hall, or CF10 3NB"
        #}
        {{
            onsAddressInput({
                "id": "address-input",
                "name": "address",
                "dontWrap": true,
                "label": {
                    "text": "Enter address or postcode and select from the results",
                    "id": "address-label-input"
                },
                "isEditable": false,
                "mandatory": true,
                "externalInitialiser": true,
                "apiDomain": "/mock-address-api",
                "apiDomainBearerToken": "prototype-token",
                "instructions": "Use up and down keys to navigate suggestions once you've typed more than two characters. Use the enter key to select a suggestion. Touch device users, explore by touch or with swipe gestures.",
                "ariaYouHaveSelected": "You have selected",
                "ariaMinChars": "Enter 3 or more characters for suggestions.",
                "ariaOneResult": "There is one suggestion available.",
                "ariaNResults": "There are {n} suggestions available.",
                "ariaLimitedResults": "Results have been limited to 10 suggestions. Type more characters to improve your search",
                "ariaGroupedResults": "There are {n} for {x}",
                "groupCount": "{n} addresses",
                "moreResults": "Enter more of the address to improve results",
                "resultsTitle": "Select an address",
                "resultsTitleId": "address-results",
                "noResults": "No results found. Try entering a different part of the address",
                "tooManyResults": "{n} results found. Enter more of the address to improve results",
                "typeMore": "Enter more of the address to get results",
                "autocomplete": "off",
                "errorTitle": "There is a problem with your answer",
                "errorMessageEnter": "Enter an address",
                "errorMessageSelect": "Select an address",
                "errorMessageApi": "Sorry, there is a problem. We are working to fix it. Please try again later or",
                "errorMessageApiLinkText": "contact us for more help",
                "options": {
                    "regionCode": "gb-eng",
                    "addressType": "residential"
                }
            })
        }}

        {%
            call onsDetails({
                "id": "help-finding-address",
                "title": "Help with finding your address",
                "classes": "ons-u-mt-m"
            })
        %}
            <p>Try typing your address different ways. For example:</p>
            {{
                onsList({
                    "itemsList": [
                        {
                            "text": "Your postcode and property name or number"
                        },
                        {
                            "text": "Your property's name or number and street name"
                        },
                        {
                            "text": "Start with your street's name and town"
                        }
                    ]
                })
            }}
            <p>If you still cannot find your address, or do not have a fixed address, <a href="#0">contact us</a>.</p>
        {% endcall %}
    {% endcall %}
{% endblock %}

{% block bodyEnd %}
    </form>
    <script src="/prototypes/student-in-halls/index.js"></script>
{% endblock %}
