# GOV.UK Notify — copy to .env for local use, and set the same keys in Netlify:
# Site configuration → Environment variables
#
# Get API key: https://www.notifications.service.gov.uk/ → API integration → API keys
# Use a Team and guest list key for prototypes
NOTIFYAPIKEY=

# SMS template ID from Notify (must include ((access_code)) personalisation)
NOTIFY_SMS_TEMPLATE_ID=
